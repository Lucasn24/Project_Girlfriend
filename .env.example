# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional, defaults to gemini-3.6-flash — see https://ai.google.dev/gemini-api/docs/pricing
# for which models currently have a free tier if this one gets deprecated
GEMINI_MODEL=

# Optional, defaults to 3001
PORT=3001

# Only needed for scripts/compare-couple-photo.ts (Flux Kontext side of the comparison)
# Get a key at https://fal.ai/dashboard/keys
FAL_KEY=

# Only needed for two-way Google Calendar sync (Settings -> Connect Google Calendar).
# Create an OAuth client (Web application) at https://console.cloud.google.com/apis/credentials
# with this exact redirect URI registered: http://localhost:3001/api/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/google/callback
